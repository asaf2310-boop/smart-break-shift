{
  "name": "VacationRequest",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d7\u05d5\u05e4\u05e9 \u05d4\u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 / \u05e1\u05d9\u05d1\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4"
    }
  },
  "required": [
    "agent_name",
    "date",
    "status"
  ]
}