{
  "name": "ShiftUnavailability",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "evening"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05de\u05e8\u05ea - \u05d1\u05d5\u05e7\u05e8 \u05d0\u05d5 \u05e2\u05e8\u05d1"
    },
    "reason": {
      "type": "string",
      "enum": [
        "unavailable",
        "vacation"
      ],
      "description": "\u05e1\u05d9\u05d1\u05d4 - \u05dc\u05d0 \u05d6\u05de\u05d9\u05df \u05d0\u05d5 \u05d7\u05d5\u05e4\u05e9"
    },
    "note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 / \u05e4\u05d9\u05e8\u05d5\u05d8 \u05e1\u05d9\u05d1\u05d4"
    }
  },
  "required": [
    "agent_name",
    "date",
    "shift_type",
    "reason"
  ]
}