{
  "name": "BreakSettings",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05d4\u05ea\u05d0\u05e8\u05d9\u05da \u05e9\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d7\u05dc\u05d5\u05ea \u05e2\u05dc\u05d9\u05d5"
    },
    "lunch_max_per_slot": {
      "type": "number",
      "description": "\u05de\u05db\u05e1\u05ea \u05e0\u05e6\u05d9\u05d2\u05d9\u05dd \u05dc\u05d4\u05e4\u05e1\u05e7\u05ea \u05e6\u05d4\u05e8\u05d9\u05d9\u05dd \u05dc\u05db\u05dc \u05de\u05e9\u05d1\u05e6\u05ea",
      "default": 2
    },
    "short_max_per_slot": {
      "type": "number",
      "description": "\u05de\u05db\u05e1\u05ea \u05e0\u05e6\u05d9\u05d2\u05d9\u05dd \u05dc\u05d4\u05e4\u05e1\u05e7\u05ea 10 \u05d3\u05e7\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05e9\u05d1\u05e6\u05ea",
      "default": 2
    },
    "show_shortage_notice": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05e4\u05d5\u05e4\u05d0\u05e4 \u05e2\u05dc \u05de\u05d7\u05e1\u05d5\u05e8 \u05d1\u05e0\u05e6\u05d9\u05d2\u05d9\u05dd",
      "default": false
    },
    "shortage_notice_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e4\u05d5\u05e4\u05d0\u05e4 \u05dc\u05de\u05d7\u05e1\u05d5\u05e8 \u05d1\u05e0\u05e6\u05d9\u05d2\u05d9\u05dd"
    }
  },
  "required": [
    "date"
  ]
}