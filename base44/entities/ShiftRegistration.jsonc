{
  "name": "ShiftRegistration",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "evening"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05de\u05e8\u05ea - \u05d1\u05d5\u05e7\u05e8 \u05d0\u05d5 \u05e2\u05e8\u05d1"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    }
  },
  "required": [
    "agent_name",
    "shift_type",
    "date"
  ]
}